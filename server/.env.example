# server/.env.example — committed. Copy to server/.env (gitignored) and fill in.
# Validated at boot by src/common/env.schema.ts.

# PostgreSQL connection (local install, trust auth on 127.0.0.1 only).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/technical_lead

# Second database for the test suite (schema is reset on every run).
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/technical_lead_test

# Random secret for better-auth (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Public base URL of the API, used by better-auth for origin checks and reset links.
# Default: http://localhost:3001. P6 changes it to the deployed origin.
# Required when NODE_ENV=production.
AUTH_BASE_URL=http://localhost:3001

# CORS allowlist, comma-separated. http://localhost:3000 now;
# P6 adds https://robiparvez.github.io.
# Required when NODE_ENV=production.
TRUSTED_ORIGINS=http://localhost:3000

# Reverse proxies in front of the API (comma-separated IPs or CIDR ranges).
# Leave empty locally. Set it when deploying behind a proxy (P6); without it
# every client shares one sign-in rate-limit bucket.
# Required when NODE_ENV=production. An empty value counts as set, for a deploy
# with no proxy.
TRUSTED_PROXIES=

# Build token for GET /v1/export, sent as the x-export-token header. The Next
# server sends it on every page request (src/lib/content.ts): set the same
# value as EXPORT_TOKEN in its environment, or let it read this file in dev.
# It reaches the API at API_URL (default http://127.0.0.1:3001).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EXPORT_TOKEN=

# Directory holding the shared content-validator rules (diagram-ids.json), read by src/content. Default when unset: the repo's
# ../src/data (computed from the module location); relative paths resolve
# against server/.
CONTENT_RULES_DIR=../src/data

# Outgoing mail (password reset link and "password changed" notice), plain SMTP.
# Dev: MailHog catches the mail; read it at http://localhost:8025. Start it with:
#   MailHog.exe -smtp-bind-addr 127.0.0.1:1025 -api-bind-addr 127.0.0.1:8025 -ui-bind-addr 127.0.0.1:8025
# Leave SMTP_HOST empty to send nothing (outside production the mail text is logged).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Technical Lead Study Guide <no-reply@localhost>

# HTTP port (dev default 3001).
PORT=3001
