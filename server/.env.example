# server/.env.example — committed. Copy to server/.env (gitignored) and fill in.
# Validated at boot by src/common/env.schema.ts.

# PostgreSQL connection (local install, trust auth on 127.0.0.1 only).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/technical_lead

# Second database for the test suite (schema is reset on every run).
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/technical_lead_test

# Random secret for better-auth (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Public base URL of the API, used by better-auth for origin checks.
# Default: http://localhost:3001. P6 changes it to the deployed origin.
AUTH_BASE_URL=http://localhost:3001

# CORS allowlist, comma-separated. http://localhost:3000 now;
# P6 adds https://robiparvez.github.io.
TRUSTED_ORIGINS=http://localhost:3000

# Build token for GET /v1/export, sent as the x-export-token header.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EXPORT_TOKEN=

# Rebuild dispatcher. false until P6; while false the worker only logs.
DISPATCH_ENABLED=false

# Fine-grained PAT (Contents: read & write) for repository_dispatch. Empty until P6.
GITHUB_REPO_DISPATCH_TOKEN=

# Directory holding the shared content-validator rules (technologies.json,
# diagram-ids.json), read by src/content. Default when unset: the repo's
# ../src/data (computed from the module location); relative paths resolve
# against server/.
CONTENT_RULES_DIR=../src/data

# HTTP port (dev default 3001).
PORT=3001
